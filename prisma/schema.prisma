// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin Authentication
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Hashed password
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// Global Delivery Modes Configuration
model DeliveryMode {
  id        String   @id @default(cuid())
  name      String   @unique // "On-site", "One-on-One", "Online", "Home Training"
  isActive  Boolean  @default(true)
  order     Int      @default(0) // For display ordering
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerings CourseOffering[]

  @@map("delivery_modes")
}

// Core Course Management
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  instrument  String   // Guitar, Piano, Drums, Vocals, Violin, Production
  level       String   // Beginner, Intermediate, Advanced, All Levels
  duration    String   @default("") // "12 weeks", "8 weeks"  (DEPRECATED display text; assessment-first rework)
  location    String   @default("") // DEPRECATED (D7): location now lives on CourseOffering -> Location. Kept for legacy rows.

  // Session fields
  session          String?   // "Fall 2024", "Summer 2025", "Spring 2025"
  sessionStartDate DateTime? // Actual start date for the session

  // Delivery modes and pricing (JSON objects for flexibility)
  // DEPRECATED (D7/D8): formats + prices now live on CourseOffering / OfferingRate. Kept (not dropped)
  // for legacy rows and the legacy tuition balance until Stream 5. New courses leave these at defaults.
  availableModes   String[]  @default([]) // Array of delivery mode names
  pricing          Json      @default("{}") // {"On-site": 25000, ...} per MODE, never per class

  // Capacity management — DEPRECATED (D9): seat counting retired, columns kept but not enforced.
  totalSeats     Int     @default(20)
  seatsLeft      Int     @default(20)
  unlimitedSeats Boolean @default(false)

  // Course content
  outcomes    String[] // Learning outcomes
  equipment   String[] // Required equipment
  image       String?  // Course image URL

  // Sample lesson video
  sampleVideoUrl      String? // URL to sample lesson video (YouTube, Vimeo, direct URL)
  sampleVideoTitle    String? // Title of sample video
  sampleVideoDuration String? // Duration display (e.g., "3:45")

  // Course status
  isActive    Boolean  @default(true)
  isPublished Boolean  @default(false)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  curriculum  CurriculumModule[]
  faqs        CourseFAQ[]
  enrollments Enrollment[]
  offerings   CourseOffering[]
  materials   Material[]
  instructors InstructorCourse[]

  @@index([instructorId])
  @@map("courses")
}

// Instructor model
// Reusable instructor roster — one instructor can teach many courses.
model Instructor {
  id           String @id @default(cuid())
  name         String
  bio          String?
  avatar       String?
  credentials  String[] // Array of credentials
  rating       Float    @default(0)
  experience   String?  // "15 years"
  availability String?  // "Mon-Fri: 9AM-6PM"
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses      Course[]
  assessments  Assessment[]

  // Scheduling (Stream 4)
  teaches       InstructorCourse[]
  availabilityWindows InstructorAvailability[]
  classSessions ClassSession[]

  @@map("instructors")
}

// Course curriculum modules
model CurriculumModule {
  id       String @id @default(cuid())
  courseId String
  module   Int    // Module number
  title    String
  weeks    String // "Weeks 1-2"
  outcomes String[] // Learning outcomes for this module
  tasks    String[] // Tasks/assignments
  order    Int    @default(0)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("curriculum_modules")
}

// Course-specific FAQs
model CourseFAQ {
  id       String @id @default(cuid())
  courseId String
  question String
  answer   String
  order    Int    @default(0)

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_faqs")
}

// Canonical person entity for enrolled students
model Student {
  id            String   @id @default(cuid())
  email         String   @unique
  firstName     String
  lastName      String
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  landmark      String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]
  parents       Parent[]  @relation("ParentChildren")

  @@map("students")
}

// Parent / guardian records, mapped to one or more enrolled students (children).
model Parent {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  address       String?
  birthdayMonth Int?     // 1-12 (day + month only, no year)
  birthdayDay   Int?     // 1-31
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // A parent can have many children; a child can have multiple guardians.
  children      Student[] @relation("ParentChildren")

  @@map("parents")
}

// Idempotency log for birthday emails — one row per recipient per calendar year,
// written only after a successful send so the daily cron never double-sends.
model BirthdayEmailLog {
  id            String   @id @default(cuid())
  recipientType String   // 'student' | 'parent'
  recipientId   String
  year          Int
  email         String
  sentAt        DateTime @default(now())

  @@unique([recipientType, recipientId, year])
  @@map("birthday_email_logs")
}

// Audit trail for admin actions
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@map("audit_logs")
}

// Enhanced enrollment tracking with comprehensive student information
model Enrollment {
  id           String   @id @default(cuid())
  courseId     String
  studentId    String

  // Student Information (dormant — kept for staged migration, cutover in later tasks)
  email        String?
  firstName    String?
  lastName     String?
  phone        String?
  dateOfBirth  DateTime?

  // Guardian Information (for students under 18)
  guardianName  String?
  guardianPhone String?
  guardianEmail String?

  // Address Information (for home training)
  address      String?
  landmark     String?

  // Course Preferences
  selectedMode       String   // Selected delivery mode
  priorLevel         String?  // complete-beginner, some-experience, intermediate, advanced
  schedulePreference String?  // weekday-morning, weekday-afternoon, etc.
  preferredDays      String[] // Preferred weekdays, canonical 'mon'..'sun' (legacy rows may hold 'Monday'; see lib/scheduling/preferences.ts)
  // Structured scheduling preferences (Stream 4). schedulePreference above is legacy, read-only fallback.
  preferredTimeBands     String[] @default([]) // morning | afternoon | evening
  preferredFromTime      String?  // 'HH:MM' Lagos local, optional narrowing of the bands
  preferredToTime        String?
  preferredClassesPerWeek Int?    // 1 | 2 (the student's wish; the plan's classesPerWeek is what is agreed)
  musicExperience    String?
  goals              String?
  specialRequests    String?

  // Policy Agreements
  agreeToTerms        Boolean @default(false)
  agreeToRefundPolicy Boolean @default(false)
  consentToEmails     Boolean @default(false)

  // Assessment fee payment (column names keep the legacy 'application' wording). Amount comes from Location.assessmentFee.
  applicationPaid     Boolean @default(false)
  applicationFeeAmount Int?    // Snapshot of Location.assessmentFee at application time

  // Enrollment Status (guard + allowed moves: lib/enrollment-status.ts)
  // pending -> assessment_paid -> assessment_scheduled -> assessed -> plan_agreed -> enrolled; cancelled from any non-terminal.
  // Legacy rows keep 'pending' / 'enrolled'. The fee is the "assessment fee" in UI copy; column names stay.
  status       String   @default("pending")

  // Location/offering the student applied for (backfilled for legacy rows; nullable)
  locationId   String?
  offeringId   String?

  // The completed fee payment that covers this application when the student had already paid the
  // assessment fee (charged ONCE PER STUDENT). Null for the application that paid it.
  feeCoveredByPaymentId String?

  // Plan fields — set when the plan is agreed after assessment. ratePerClass is a SNAPSHOT:
  // later OfferingRate edits never move an existing student's price.
  durationMins   Int?
  classesPerWeek Int?
  plannedClasses Int?
  ratePerClass   Int?

  // Additional Information
  couponCode   String?
  waitlistNotes String?

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  course              Course              @relation(fields: [courseId], references: [id])
  student             Student             @relation(fields: [studentId], references: [id])
  feeCoveredBy        ApplicationPayment? @relation("FeeCoverage", fields: [feeCoveredByPaymentId], references: [id], onDelete: SetNull)
  location            Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  offering            CourseOffering?     @relation("EnrollmentOffering", fields: [offeringId], references: [id], onDelete: SetNull)
  applicationPayments ApplicationPayment[]
  tuitionPayments     TuitionPayment[]
  assessments         Assessment[]
  classSessions       ClassSession[]

  @@unique([id, studentId]) // target of ClassSession's composite FK (keeps session.studentId honest)
  @@index([studentId])
  @@index([locationId])
  @@index([offeringId])
  @@index([feeCoveredByPaymentId])
  @@map("enrollments")
}

// Application fee payment tracking (location-based pricing)
model ApplicationPayment {
  id                String   @id @default(cuid())
  enrollmentId      String

  // Payment Details
  amount            Int      // Application fee (varies by course location)
  currency          String   @default("NGN")
  paymentMethod     String   // Paystack payment channel (card, bank, ussd, bank_transfer)

  // Paystack Integration
  paystackReference String?  @unique
  paystackStatus    String   @default("pending") // pending, success, failed, abandoned
  authorizationCode String?

  // Payment Status
  // pending, completed, failed; superseded = a cash/offline fee covered the application first;
  // duplicate = money received on top of an already-paid fee (needs a manual refund); refunded.
  status            String   @default("pending")
  paidAt            DateTime?
  refundedAt        DateTime? // set when an admin records the duplicate as refunded (refund done by hand in Paystack)
  refundedBy        String?   // Admin id

  // Receipt Information
  receiptNumber     String   @unique
  receiptGenerated  Boolean  @default(false)
  receiptSent       Boolean  @default(false)

  // Billing Information
  billingEmail      String
  billingName       String
  billingAddress    String?
  billingCity       String?
  billingState      String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  coveredEnrollments Enrollment[] @relation("FeeCoverage")

  @@map("application_payments")
}

// Tuition payment tracking (managed by admin)
model TuitionPayment {
  id            String   @id @default(cuid())
  enrollmentId  String

  // Payment Details
  amount        Int      // Variable tuition amount
  currency      String   @default("NGN")
  paymentMethod String   // cash, bank-transfer, card, etc.
  description   String?  // Payment description/notes

  // Payment Status
  status        String   @default("pending") // pending, completed, partial, cancelled
  paidAt        DateTime?

  // Receipt Information
  receiptNumber String   @unique
  receiptGenerated Boolean @default(false)
  receiptSent   Boolean  @default(false)

  // Admin Information
  recordedBy    String?  // Admin ID who recorded the payment
  adminNotes    String?

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("tuition_payments")
}

enum LocationKind {
  PHYSICAL
  ONLINE
}

// A place (or online/diaspora "virtual place") where Banafix teaches. Admin-editable (D11).
model Location {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique // public chooser key: /courses?location=<slug>
  kind          LocationKind @default(PHYSICAL)
  assessmentFee Int          // whole naira, non-refundable; replaces calculateApplicationFee
  isActive      Boolean      @default(true)
  order         Int          @default(0)
  address       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  offerings     CourseOffering[]
  enrollments   Enrollment[]
  availability  InstructorAvailability[]
  classSessions ClassSession[]

  @@map("locations")
}

// course x location x format. Replaces Course.pricing/availableModes/location (D7).
model CourseOffering {
  id                    String   @id @default(cuid())
  courseId              String
  locationId            String
  deliveryModeId        String
  classesPerWeekOptions Int[]    @default([1, 2])
  isActive              Boolean  @default(false) // legacy-migrated offerings are inactive with no rates
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id])
  deliveryMode DeliveryMode @relation(fields: [deliveryModeId], references: [id])
  rates        OfferingRate[]
  enrollments  Enrollment[] @relation("EnrollmentOffering")
  recommendedFor Assessment[] @relation("AssessmentRecommendedOffering")

  @@unique([courseId, locationId, deliveryModeId])
  @@index([locationId])
  @@map("course_offerings")
}

// Per-class price for an offering at a class duration (45 / 60 min). D8.
model OfferingRate {
  id           String   @id @default(cuid())
  offeringId   String
  durationMins Int
  pricePerClass Int     // whole naira per class
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offering     CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, durationMins])
  @@map("offering_rates")
}

// Course-level books/materials (consumed by Stream 5 invoicing; admin-editable now).
model Material {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  price     Int      // whole naira
  required  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("materials")
}

// An assessment of a student (many per enrollment: re-assessment). Result is editable and audited.
model Assessment {
  id                     String    @id @default(cuid())
  enrollmentId           String
  status                 String    @default("requested") // requested, scheduled, completed, cancelled, no_show
  arrangement            String    // HOME | CENTRE | ONLINE
  preferredDate          DateTime?
  preferredTimeBand      String?   // morning | afternoon | evening | flexible
  address                String?   // home-visit location (arrangement HOME)
  landmark               String?
  scheduledAt            DateTime?
  assessorId             String?
  resultLevel            String?
  resultNotes            String?
  recommendedOfferingId  String?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  enrollment             Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessor               Instructor?     @relation(fields: [assessorId], references: [id], onDelete: SetNull)
  recommendedOffering    CourseOffering? @relation("AssessmentRecommendedOffering", fields: [recommendedOfferingId], references: [id], onDelete: SetNull)

  @@index([enrollmentId])
  @@map("assessments")
}

// ---------------------------------------------------------------------------
// Scheduling (Stream 4). Spec: docs/superpowers/specs/2026-11-03-scheduling-design.md
// Raw-SQL constraints (btree_gist exclusion, CHECKs, partial unique) live in the migration
// and are NOT modelled here; Prisma ignores them.
// ---------------------------------------------------------------------------

// Which courses an instructor teaches (M:N). Course.instructorId stays as the public /tutors "primary".
model InstructorCourse {
  instructorId String
  courseId     String
  createdAt    DateTime @default(now())

  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([instructorId, courseId])
  @@index([courseId])
  @@map("instructor_courses")
}

// "On this weekday, between these local times, at this place, in this mode."
// weekday ISO 1..7 (Mon..Sun); minutes from Lagos local midnight. DB prevents overlapping windows per instructor+weekday.
model InstructorAvailability {
  id           String   @id @default(cuid())
  instructorId String
  weekday      Int
  startMinute  Int
  endMinute    Int
  locationId   String
  mode         String   // CENTRE | HOME | ONLINE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  location     Location   @relation(fields: [locationId], references: [id])

  @@index([instructorId, weekday])
  @@index([locationId])
  @@map("instructor_availability")
}

// One booked class. No money here (D12): Stream 5 joins on (enrollmentId, sequence).
// Active (blocks time) = scheduled | held; the exclusion constraints in the migration enforce it per instructor and per student.
model ClassSession {
  id               String   @id @default(cuid())
  enrollmentId     String
  studentId        String   // denormalised for the student exclusion constraint; composite FK keeps it equal to the enrollment's
  instructorId     String
  locationId       String?
  mode             String   // CENTRE | HOME | ONLINE
  startsAt         DateTime @db.Timestamptz(3)
  durationMins     Int      // 45 | 60 (CHECK)
  endsAt           DateTime @db.Timestamptz(3) // = startsAt + durationMins (CHECK); stored because timestamptz + interval is not indexable
  status           String   @default("scheduled") // scheduled | held | missed | rescheduled | cancelled
  sequence         Int      // class slot 1..n within the enrollment
  rescheduledFromId String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollment       Enrollment   @relation(fields: [enrollmentId, studentId], references: [id, studentId], onDelete: Restrict)
  instructor       Instructor   @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  location         Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rescheduledFrom  ClassSession?  @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo    ClassSession[] @relation("Reschedule")

  @@index([instructorId, startsAt])
  @@index([enrollmentId, sequence])
  @@index([studentId, startsAt])
  @@map("class_sessions")
}

// System Settings for global configuration
model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique // e.g., "platform_name", "contact_email"
  value String
  type  String @default("text") // text, boolean, number, json

  @@map("system_settings")
}

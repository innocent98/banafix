# Banafix — environment variables (template)
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is committed.
# "required" = the app/feature breaks without it. "optional" = has a safe in-code default.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Prisma / PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
# required — app runtime connection. In production this is the Prisma Accelerate URL.
DATABASE_URL="postgresql://user:password@host:5432/banafix?schema=public"
# NOTE: `prisma migrate deploy` CANNOT run against the Accelerate proxy. To run
# migrations (incl. the postinstall deploy step), point at a DIRECT Postgres URL —
# either set DATABASE_URL to the direct URL for the migration, or add
# `directUrl = env("DIRECT_URL")` to prisma/schema.prisma datasource and set:
# DIRECT_URL="postgresql://user:password@host:5432/banafix?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Admin auth
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-long-random-string"   # required — signs admin session JWTs

# ─────────────────────────────────────────────────────────────────────────────
# App URLs
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000" # required — public base URL for links & Paystack callback
NEXTAUTH_URL="http://localhost:3000"         # optional — fallback base URL for the Paystack callback
NEXTAUTH_SECRET=""                           # optional/legacy — only if next-auth is used

# ─────────────────────────────────────────────────────────────────────────────
# Payments (Paystack)
# ─────────────────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="your-paystack-secret-key"   # required — server API + webhook signature
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"   # required — client init

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"  # required for ALL email (receipts, acks, birthdays)
FROM_EMAIL="noreply@banafix.com"     # optional — sender; must be a verified Resend domain to deliver
SUPPORT_EMAIL="support@banafix.com"  # optional — shown to users for support
ADMIN_EMAIL="admin@banafix.com"      # optional — admin notices/receipt copies (defaults to SUPPORT_EMAIL)

# ─────────────────────────────────────────────────────────────────────────────
# Storage (Vercel Blob) — course image uploads
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"  # required for admin image uploads

# ─────────────────────────────────────────────────────────────────────────────
# Communications (outbox) — docs/sop/communications.md
# ─────────────────────────────────────────────────────────────────────────────
FEEDBACK_EMAIL="feedback@banafix.com"  # optional — dedicated feedback inbox: shown on /feedback, receives "new feedback" notices (falls back to ADMIN_EMAIL)
# SMS_PROVIDER=""                       # optional — name of the chosen SMS provider. No adapter is built yet: messages are recorded as Skipped
# WHATSAPP_PROVIDER=""                  # optional — same for WhatsApp
# MESSAGING_EMAIL_PROVIDER="fake"       # dev/test ONLY — records emails in memory instead of sending. Ignored when NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# Cron (birthdays, new-month message, outbox drain)
# ─────────────────────────────────────────────────────────────────────────────
# required for the cron routes — GET /api/cron/{birthdays,new-month,messages} 401 without a match.
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically when this is set.
CRON_SECRET="change-me-long-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# Local test harness (optional — dev only; used by scripts/test-*.ts)
# ─────────────────────────────────────────────────────────────────────────────
TEST_EMAIL_TO="you@example.com"          # optional — recipient for npm run test:emails
WEBHOOK_TEST_URL="http://localhost:3000" # optional — target for npm run test:webhook
